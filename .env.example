# seedpath configuration. Copy to .env and fill in.
# All variables are optional except the rTorrent endpoint and at least one app.

# --- rTorrent / ruTorrent ---------------------------------------------------
RT_URL=http://rtorrent:8000/RPC2
# Leave empty when the XML-RPC endpoint has no Basic auth.
RT_USER=rtorrent
RT_PASS=change-me
# Set false only for a self-signed rTorrent HTTPS certificate.
RT_VERIFY_TLS=true

# --- Servarr apps (uncomment URL and key together) --------------------------
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# LIDARR_URL=http://lidarr:8686
# LIDARR_API_KEY=
# READARR_URL=http://readarr:8787
# READARR_API_KEY=
# WHISPARR_URL=http://whisparr:6969
# WHISPARR_API_KEY=

# Multiple instances or custom names:
# APPS_JSON=[{"name":"radarr4k","kind":"radarr","url":"http://radarr4k:7878","api_key":"..."}]

# --- Placement policy -------------------------------------------------------
# JSON array. seedpath refuses to place outside these paths.
LIBRARY_ROOTS=["/data/movies","/data/tv"]
# JSON object: rTorrent category -> app instance name. Omit it to derive the
# defaults from the configured apps (radarr, tv-sonarr, lidarr, readarr).
# CATEGORY_MAP={"radarr":"radarr","tv-sonarr":"sonarr"}
DRY_RUN=false

# --- Timing (bare numbers are seconds; 500ms / 10s / 1m / 2h also work) -----
RESOLVE_TIMEOUT=10s
RESCAN_POLL=30s
RECONCILE_INTERVAL=300s
LOAD_TIMEOUT=30s
UPSTREAM_TIMEOUT=30s

# --- HTTP server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
RPC_PATH=/RPC2
INGRESS_AUTH=true
MAX_BODY_BYTES=16777216

# --- State and logging ------------------------------------------------------
# Local runs default to ./data/state.db. Leave this commented in Compose so the
# image's /config/state.db (inside the mounted volume) is used.
# STATE_PATH=./data/state.db
LOG_LEVEL=INFO
LOG_FORMAT=json
WORKER_COUNT=2
WORKER_QUEUE_SIZE=1000
